# ==============================================================================
# AgriAI Platform - Streamlit Community Cloud Secrets Example
# Copy these keys into your Streamlit Cloud Settings > Secrets if needed.
# For 100% Zero-Cost deployment, all fields below are OPTIONAL and have safe fallbacks.
# ==============================================================================

# Backend URL (Leave empty or omit on Streamlit Community Cloud for in-process mode)
BACKEND_URL = ""

# Application Environment
APP_ENV = "production"
DEFAULT_STATE = "Andhra Pradesh"
DEFAULT_DISTRICT = "Guntur"

# Optional External API Keys (Leave empty for built-in zero-cost local inference)
OPENAI_API_KEY = ""
SNOWFLAKE_ACCOUNT = ""
