# ==============================================================================
# AgriAI Platform - Environment Configuration Template
# Copy this file to .env and populate your environment-specific credentials.
# Do NOT commit .env with real credentials to source control.
# ==============================================================================

# Core Application Settings
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO
SECRET_KEY=change_this_to_a_secure_random_hex_key_in_production
API_V1_STR=/api/v1
PROJECT_NAME="AgriAI - Smart Agriculture Intelligence Platform"

# Backend & Frontend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
FRONTEND_PORT=8501

# Regional Defaults (Configurable for expansion across Indian states)
DEFAULT_STATE="Andhra Pradesh"
DEFAULT_DISTRICT="Guntur"
TARGET_DISTRICTS="Guntur,Krishna,Kurnool,Anantapur,East Godavari,Chittoor,Prakasam,West Godavari,Visakhapatnam,Nellore,YSR Kadapa,Srikakulam,Vizianagaram"

# Local Storage Paths (Relative or Absolute)
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
SAMPLE_DATA_DIR=./data/sample
UPLOAD_DIR=./data/uploads
MODEL_REGISTRY_DIR=./disease_detection/saved_models
ML_MODEL_DIR=./ml/saved_models

# PostgreSQL Database (Local Relational Store & Warehouse)
POSTGRES_USER=agriai_admin
POSTGRES_PASSWORD=agriai_local_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agriai_db
DATABASE_URL=postgresql://agriai_admin:agriai_local_pass@localhost:5432/agriai_db

# Snowflake Cloud Data Warehouse (Optional - Enabled in Cloud Mode)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=AGRIAI_DW
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_SCHEMA=GOLD_MARTS
SNOWFLAKE_ROLE=ACCOUNTADMIN

# AWS S3 Cloud Object Storage (Optional - Enabled in Cloud Mode)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=agriai-data-lake-ap

# Generative AI & LLM Provider Settings
# Options: "gemini", "openai", "groq", or "mock" (offline fallback)
LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_DB_TYPE=faiss
CHROMA_PERSIST_DIR=./data/vector_store

# Weather Service Integration
# Options: "open-meteo" (free, no key required), "imd", "openweathermap"
WEATHER_PROVIDER=open-meteo
OPENWEATHERMAP_API_KEY=

# Airflow Configuration
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
